{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/sign-up": {
      "post": {
        "description": "US04 : crée un compte avec le rôle PARTICIPANT. N'ouvre pas de session : le client enchaîne avec `POST /auth/sign-in`.",
        "operationId": "signUp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Compte créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                },
                "example": {
                  "id": "3f0c1a52-6a3e-4b8e-9a43-0d7f1e2b9c11",
                  "email": "lea.dupont@example.com",
                  "firstName": "Léa",
                  "lastName": "Dupont",
                  "role": "PARTICIPANT"
                }
              }
            }
          },
          "400": {
            "description": "Champ manquant ou invalide (mot de passe de moins de 8 caractères…)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 400,
                  "error": "Bad Request",
                  "message": "La requête contient des champs invalides",
                  "details": [
                    {
                      "field": "email",
                      "message": "L'email n'est pas valide"
                    },
                    {
                      "field": "password",
                      "message": "Le mot de passe doit contenir au moins 8 caractères"
                    }
                  ],
                  "path": "/api/v1/auth/sign-up",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          },
          "409": {
            "description": "Email déjà utilisé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 409,
                  "error": "Conflict",
                  "message": "Un compte existe déjà avec cet email",
                  "path": "/api/v1/auth/sign-up",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          }
        },
        "summary": "Créer un compte participant",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sign-in": {
      "post": {
        "description": "US04 : ouvre une session de 7 jours portée par le cookie HttpOnly `eventhub_session`. Des identifiants invalides renvoient toujours le même 401, sans préciser si l'email ou le mot de passe est faux.",
        "operationId": "signIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connecté : renvoie l’utilisateur et pose le cookie de session",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie de session HttpOnly, SameSite=Lax, Secure en production",
                "schema": {
                  "type": "string",
                  "example": "eventhub_session=kq3…Zx; Max-Age=604800; Path=/; HttpOnly; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                },
                "example": {
                  "id": "3f0c1a52-6a3e-4b8e-9a43-0d7f1e2b9c11",
                  "email": "lea.dupont@example.com",
                  "firstName": "Léa",
                  "lastName": "Dupont",
                  "role": "PARTICIPANT"
                }
              }
            }
          },
          "400": {
            "description": "Champ manquant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 400,
                  "error": "Bad Request",
                  "message": "La requête contient des champs invalides",
                  "details": [
                    {
                      "field": "password",
                      "message": "Le mot de passe est obligatoire"
                    }
                  ],
                  "path": "/api/v1/auth/sign-in",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          },
          "401": {
            "description": "Identifiants invalides (message générique)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 401,
                  "error": "Unauthorized",
                  "message": "Email ou mot de passe incorrect",
                  "path": "/api/v1/auth/sign-in",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          }
        },
        "summary": "Se connecter",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sign-out": {
      "post": {
        "description": "US04 : supprime la session en base et efface le cookie. Idempotent : renvoie 204 même sans session valide.",
        "operationId": "signOut",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Session supprimée"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Se déconnecter",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "description": "US04 : renvoie l’utilisateur de la session courante (le layout affiche son prénom).",
        "operationId": "me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                },
                "example": {
                  "id": "3f0c1a52-6a3e-4b8e-9a43-0d7f1e2b9c11",
                  "email": "lea.dupont@example.com",
                  "firstName": "Léa",
                  "lastName": "Dupont",
                  "role": "PARTICIPANT"
                }
              }
            }
          },
          "401": {
            "description": "Pas de session, ou session expirée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 401,
                  "error": "Unauthorized",
                  "message": "Authentification requise",
                  "path": "/api/v1/auth/me",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Utilisateur connecté",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/events": {
      "get": {
        "description": "US01 et US02 : liste triée par date de début croissante, filtrable par période, catégorie et ville. Les filtres se combinent.",
        "operationId": "listEvents",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 12,
              "type": "integer"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Début de la période (date `YYYY-MM-DD` ou date-heure ISO 8601). Par défaut : maintenant, le catalogue n'affiche donc que les événements à venir.",
            "schema": {
              "example": "2026-12-01",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Fin de la période, incluse (une date seule couvre toute la journée, en UTC).",
            "schema": {
              "example": "2026-12-31",
              "type": "string"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Slug de la catégorie",
            "schema": {
              "example": "concert",
              "type": "string"
            }
          },
          {
            "name": "city",
            "required": false,
            "in": "query",
            "description": "Ville (recherche partielle, insensible à la casse)",
            "schema": {
              "example": "Lyon",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedEventsDto"
                }
              }
            }
          },
          "400": {
            "description": "Paramètre de requête invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Catalogue paginé des événements",
        "tags": [
          "events"
        ]
      }
    },
    "/api/v1/events/{id}": {
      "get": {
        "description": "US03 : description, organisateur, date, lieu et places restantes.",
        "operationId": "getEvent",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identifiant de l'événement",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Événement inconnu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Détail d'un événement",
        "tags": [
          "events"
        ]
      }
    },
    "/api/v1/categories": {
      "get": {
        "operationId": "listCategories",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Liste les catégories (filtre du catalogue)",
        "tags": [
          "categories"
        ]
      }
    },
    "/api/v1/events/{id}/registrations": {
      "post": {
        "description": "US05 : inscrit l'utilisateur connecté, dans une transaction qui verrouille l'événement : deux inscriptions simultanées ne peuvent pas dépasser la capacité. Une inscription est refusée (409) si l'utilisateur est déjà inscrit, si l'événement est complet ou s'il est passé.",
        "operationId": "registerToEvent",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identifiant de l'événement",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Inscription enregistrée ; renvoie les places restantes à jour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationDto"
                },
                "example": {
                  "id": "9b1d2c3e-4f5a-4b6c-8d7e-0a1b2c3d4e5f",
                  "eventId": "3f0c1a52-6a3e-4b8e-9a43-0d7f1e2b9c11",
                  "createdAt": "2026-11-20T10:33:21.774Z",
                  "remainingSeats": 41,
                  "isFull": false
                }
              }
            }
          },
          "401": {
            "description": "Pas de session, ou session expirée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 401,
                  "error": "Unauthorized",
                  "message": "Authentification requise",
                  "path": "/api/v1/events/3f0c1a52-6a3e-4b8e-9a43-0d7f1e2b9c11/registrations",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          },
          "404": {
            "description": "Événement inconnu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 404,
                  "error": "Not Found",
                  "message": "L'événement demandé n'existe pas",
                  "path": "/api/v1/events/3f0c1a52-6a3e-4b8e-9a43-0d7f1e2b9c11/registrations",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          },
          "409": {
            "description": "Déjà inscrit, événement complet ou événement passé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 409,
                  "error": "Conflict",
                  "message": "Vous êtes déjà inscrit à cet événement",
                  "path": "/api/v1/events/3f0c1a52-6a3e-4b8e-9a43-0d7f1e2b9c11/registrations",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "S'inscrire à un événement",
        "tags": [
          "registrations"
        ]
      }
    },
    "/api/v1/registrations/me": {
      "get": {
        "description": "US06 : inscriptions de l'utilisateur connecté, de l'événement le plus proche au plus lointain, passées comprises (l'annulation n'est possible que pour les événements à venir).",
        "operationId": "listMyRegistrations",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Liste vide si aucune inscription",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserRegistrationDto"
                  }
                },
                "example": [
                  {
                    "id": "9b1d2c3e-4f5a-4b6c-8d7e-0a1b2c3d4e5f",
                    "createdAt": "2026-11-20T10:33:21.774Z",
                    "event": {
                      "id": "3f0c1a52-6a3e-4b8e-9a43-0d7f1e2b9c11",
                      "title": "Nuit du jazz",
                      "startsAt": "2026-12-05T18:00:00.000Z",
                      "endsAt": "2026-12-05T21:00:00.000Z",
                      "venue": "Le Transbordeur",
                      "city": "Lyon",
                      "capacity": 300,
                      "priceCents": 1500,
                      "remainingSeats": 41,
                      "isFull": false,
                      "imageUrl": null,
                      "category": {
                        "id": "5d1f0c52-6a3e-4b8e-9a43-0d7f1e2b9c22",
                        "name": "Concert",
                        "slug": "concert"
                      }
                    }
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Pas de session, ou session expirée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 401,
                  "error": "Unauthorized",
                  "message": "Authentification requise",
                  "path": "/api/v1/registrations/me",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Mes inscriptions",
        "tags": [
          "registrations"
        ]
      }
    },
    "/api/v1/registrations/{id}": {
      "delete": {
        "description": "US06 : supprime l'inscription et libère la place (les places restantes augmentent de 1). Réservé au propriétaire de l'inscription (403 sinon) ; impossible pour un événement passé (409).",
        "operationId": "cancelRegistration",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identifiant de l'inscription",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Inscription annulée"
          },
          "401": {
            "description": "Pas de session, ou session expirée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 401,
                  "error": "Unauthorized",
                  "message": "Authentification requise",
                  "path": "/api/v1/registrations/9b1d2c3e-4f5a-4b6c-8d7e-0a1b2c3d4e5f",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          },
          "403": {
            "description": "L'inscription appartient à un autre utilisateur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 403,
                  "error": "Forbidden",
                  "message": "Vous ne pouvez pas annuler l'inscription d'un autre participant",
                  "path": "/api/v1/registrations/9b1d2c3e-4f5a-4b6c-8d7e-0a1b2c3d4e5f",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          },
          "404": {
            "description": "Inscription inconnue (ou déjà annulée)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 404,
                  "error": "Not Found",
                  "message": "L'inscription demandée n'existe pas",
                  "path": "/api/v1/registrations/9b1d2c3e-4f5a-4b6c-8d7e-0a1b2c3d4e5f",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          },
          "409": {
            "description": "Événement déjà passé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 409,
                  "error": "Conflict",
                  "message": "Impossible d'annuler l'inscription à un événement passé",
                  "path": "/api/v1/registrations/9b1d2c3e-4f5a-4b6c-8d7e-0a1b2c3d4e5f",
                  "timestamp": "2026-11-20T10:33:21.774Z"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Annuler une inscription",
        "tags": [
          "registrations"
        ]
      }
    }
  },
  "info": {
    "title": "EventHub API",
    "description": "Contrat de l’API EventHub. Toutes les erreurs suivent le schéma `ApiErrorDto`.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "eventhub_session",
        "description": "Posé par `POST /auth/sign-in`"
      }
    },
    "schemas": {
      "SignUpDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Léa",
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "example": "Dupont",
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "example": "lea.dupont@example.com",
            "format": "email",
            "description": "Normalisé côté serveur : espaces retirés et passage en minuscules."
          },
          "password": {
            "type": "string",
            "example": "motdepasse-solide",
            "format": "password",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email",
          "password"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "PARTICIPANT",
          "ORGANIZER"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3f0c1a52-6a3e-4b8e-9a43-0d7f1e2b9c11"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "lea.dupont@example.com"
          },
          "firstName": {
            "type": "string",
            "example": "Léa"
          },
          "lastName": {
            "type": "string",
            "example": "Dupont"
          },
          "role": {
            "example": "PARTICIPANT",
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "role"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "pageSize",
            "description": "Champ en erreur (notation pointée pour les objets imbriqués)"
          },
          "message": {
            "type": "string",
            "example": "pageSize doit être inférieur ou égal à 50"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "error": {
            "type": "string",
            "example": "Not Found",
            "description": "Libellé HTTP du code de statut"
          },
          "message": {
            "type": "string",
            "example": "L'événement demandé n'existe pas"
          },
          "details": {
            "description": "Présent uniquement pour les erreurs de validation (400)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          },
          "path": {
            "type": "string",
            "example": "/api/v1/events/0b6f…"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "path",
          "timestamp"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
