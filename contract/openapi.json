{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/events": {
      "get": {
        "description": "US01 et US02 : liste triée par date de début croissante, filtrable par période, catégorie et ville. Les filtres se combinent.",
        "operationId": "listEvents",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 12,
              "type": "integer"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Début de la période (date `YYYY-MM-DD` ou date-heure ISO 8601). Par défaut : maintenant, le catalogue n'affiche donc que les événements à venir.",
            "schema": {
              "example": "2026-12-01",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Fin de la période, incluse (une date seule couvre toute la journée, en UTC).",
            "schema": {
              "example": "2026-12-31",
              "type": "string"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Slug de la catégorie",
            "schema": {
              "example": "concert",
              "type": "string"
            }
          },
          {
            "name": "city",
            "required": false,
            "in": "query",
            "description": "Ville (recherche partielle, insensible à la casse)",
            "schema": {
              "example": "Lyon",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedEventsDto"
                }
              }
            }
          },
          "400": {
            "description": "Paramètre de requête invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Catalogue paginé des événements",
        "tags": [
          "events"
        ]
      }
    },
    "/api/v1/events/{id}": {
      "get": {
        "description": "US03 : description, organisateur, date, lieu et places restantes.",
        "operationId": "getEvent",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identifiant de l'événement",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Événement inconnu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Détail d'un événement",
        "tags": [
          "events"
        ]
      }
    },
    "/api/v1/categories": {
      "get": {
        "operationId": "listCategories",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Liste les catégories (filtre du catalogue)",
        "tags": [
          "categories"
        ]
      }
    }
  },
  "info": {
    "title": "EventHub API",
    "description": "Contrat de l’API EventHub. Toutes les erreurs suivent le schéma `ApiErrorDto`.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Concert"
          },
          "slug": {
            "type": "string",
            "example": "concert",
            "description": "Identifiant lisible utilisé dans les filtres"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "EventSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "example": "Nuit du jazz"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "venue": {
            "type": "string",
            "example": "Le Transbordeur",
            "description": "Nom du lieu"
          },
          "city": {
            "type": "string",
            "example": "Lyon"
          },
          "capacity": {
            "type": "number",
            "example": 300,
            "minimum": 1
          },
          "priceCents": {
            "type": "integer",
            "example": 1500,
            "minimum": 0,
            "description": "Prix en centimes d’euro (0 = gratuit)"
          },
          "remainingSeats": {
            "type": "number",
            "example": 42,
            "minimum": 0,
            "description": "Places encore disponibles"
          },
          "isFull": {
            "type": "boolean",
            "description": "Vrai si plus aucune place n’est disponible"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "category": {
            "$ref": "#/components/schemas/CategoryDto"
          }
        },
        "required": [
          "id",
          "title",
          "startsAt",
          "endsAt",
          "venue",
          "city",
          "capacity",
          "priceCents",
          "remainingSeats",
          "isFull",
          "imageUrl",
          "category"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1,
            "minimum": 1
          },
          "pageSize": {
            "type": "number",
            "example": 12,
            "minimum": 1
          },
          "total": {
            "type": "number",
            "example": 42,
            "minimum": 0,
            "description": "Nombre total d’éléments correspondant aux filtres"
          },
          "totalPages": {
            "type": "number",
            "example": 4,
            "minimum": 0
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      },
      "PaginatedEventsDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventSummaryDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "pageSize",
            "description": "Champ en erreur (notation pointée pour les objets imbriqués)"
          },
          "message": {
            "type": "string",
            "example": "pageSize doit être inférieur ou égal à 50"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "error": {
            "type": "string",
            "example": "Not Found",
            "description": "Libellé HTTP du code de statut"
          },
          "message": {
            "type": "string",
            "example": "L'événement demandé n'existe pas"
          },
          "details": {
            "description": "Présent uniquement pour les erreurs de validation (400)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          },
          "path": {
            "type": "string",
            "example": "/api/v1/events/0b6f…"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "path",
          "timestamp"
        ]
      },
      "OrganizerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Camille Martin"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "EventDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "example": "Nuit du jazz"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "venue": {
            "type": "string",
            "example": "Le Transbordeur",
            "description": "Nom du lieu"
          },
          "city": {
            "type": "string",
            "example": "Lyon"
          },
          "capacity": {
            "type": "number",
            "example": 300,
            "minimum": 1
          },
          "priceCents": {
            "type": "integer",
            "example": 1500,
            "minimum": 0,
            "description": "Prix en centimes d’euro (0 = gratuit)"
          },
          "remainingSeats": {
            "type": "number",
            "example": 42,
            "minimum": 0,
            "description": "Places encore disponibles"
          },
          "isFull": {
            "type": "boolean",
            "description": "Vrai si plus aucune place n’est disponible"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "category": {
            "$ref": "#/components/schemas/CategoryDto"
          },
          "description": {
            "type": "string"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "example": "3 boulevard de Stalingrad"
          },
          "organizer": {
            "$ref": "#/components/schemas/OrganizerDto"
          }
        },
        "required": [
          "id",
          "title",
          "startsAt",
          "endsAt",
          "venue",
          "city",
          "capacity",
          "priceCents",
          "remainingSeats",
          "isFull",
          "imageUrl",
          "category",
          "description",
          "address",
          "organizer"
        ]
      }
    }
  }
}
