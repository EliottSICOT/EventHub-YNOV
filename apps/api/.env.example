PORT=3000
# "production" active l'attribut Secure du cookie de session (HTTPS obligatoire)
NODE_ENV=development
DATABASE_URL="postgresql://eventhub:eventhub@localhost:5432/eventhub?schema=public"
# URL où le Front est servi : seule origine autorisée par le CORS (avec credentials), liens dans les e-mails
FRONT_URL="http://localhost:5173"
# E-mails : Mailpit en dev (http://localhost:8025). SMTP_HOST vide désactive l'envoi
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="EventHub <no-reply@eventhub.test>"
