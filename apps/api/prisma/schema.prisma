// Schéma EventHub : users, events, categories, registrations.
// Après chaque modification : `pnpm prisma migrate dev --name <nom>`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  role          Role           @default(PARTICIPANT)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  events        Event[]
  registrations Registration[]

  @@map("users")
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique
  events Event[]

  @@map("categories")
}

model Event {
  id            String         @id @default(uuid())
  title         String
  description   String
  startsAt      DateTime       @map("starts_at")
  endsAt        DateTime?      @map("ends_at")
  venue         String
  address       String?
  city          String
  capacity      Int
  /// Prix en centimes d'euro, 0 pour un événement gratuit
  priceCents    Int            @default(0) @map("price_cents")
  imageUrl      String?        @map("image_url")
  categoryId    String         @map("category_id")
  category      Category       @relation(fields: [categoryId], references: [id])
  organizerId   String         @map("organizer_id")
  organizer     User           @relation(fields: [organizerId], references: [id])
  registrations Registration[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([startsAt])
  @@index([categoryId, startsAt])
  @@index([city])
  @@map("events")
}

model Registration {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@index([userId])
  @@map("registrations")
}
