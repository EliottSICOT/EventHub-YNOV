// Schéma EventHub : users, events, categories, registrations.
// Après chaque modification : `pnpm prisma migrate dev --name <nom>`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String          @map("password_hash")
  firstName       String          @map("first_name")
  lastName        String          @map("last_name")
  role            Role            @default(PARTICIPANT)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  events          Event[]
  registrations   Registration[]
  waitlistEntries WaitlistEntry[]
  sessions        Session[]

  @@map("users")
}

/// Session ouverte par POST /auth/sign-in. Le cookie porte le jeton brut ;
/// la base n'en garde que l'empreinte SHA-256, inutilisable en cas de fuite.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique
  events Event[]

  @@map("categories")
}

model Event {
  id              String          @id @default(uuid())
  title           String
  description     String
  startsAt        DateTime        @map("starts_at")
  endsAt          DateTime?       @map("ends_at")
  venue           String
  address         String?
  city            String
  capacity        Int
  /// Prix en centimes d'euro, 0 pour un événement gratuit
  priceCents      Int             @default(0) @map("price_cents")
  imageUrl        String?         @map("image_url")
  /// Événement supprimé par son organisateur (US09) : la ligne reste, pour que les inscrits
  /// voient « Événement annulé ».
  cancelledAt     DateTime?       @map("cancelled_at")
  categoryId      String          @map("category_id")
  category        Category        @relation(fields: [categoryId], references: [id])
  organizerId     String          @map("organizer_id")
  organizer       User            @relation(fields: [organizerId], references: [id])
  registrations   Registration[]
  waitlistEntries WaitlistEntry[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([startsAt])
  @@index([categoryId, startsAt])
  @@index([city])
  @@map("events")
}

model Registration {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@index([userId])
  @@map("registrations")
}

/// File d'attente FIFO quand un événement est complet (US14).
model WaitlistEntry {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@index([eventId, createdAt])
  @@index([userId])
  @@map("waitlist_entries")
}
